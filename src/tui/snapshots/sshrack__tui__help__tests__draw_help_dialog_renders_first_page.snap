"          ┌  help  ──────────────────────────────────────────────────────────────────────┐          "
"          │Tabs                                                                          │          "
"          │  Tab / Shift-Tabcycle tabs (Hosts / Credentials / Settings)                  │          "
"          │  type          filter the active panel's search box                          │          "
"          │  Up / Down     move selection (wraps)                                        │          "
"          │  Ctrl-N / Ctrl-Pmove selection (wraps)                                       │          "
"          │                                                                              │          "
"          │Hosts panel                                                                   │          "
"          │  Enter         connect to the selected host                                  │          "
"          │  Ctrl-A        add (current tab)                                             │          "
"          │  Ctrl-E        edit the selected host                                        │          "
"          │  Ctrl-D        delete the selected host (confirm)                            │          "
"          │                                                                              │          "
"          │Credentials panel                                                             │          "
"          │  Enter         edit the selected credential                                  │          "
"          │  Ctrl-A        add (current tab)                                             │          "
"          │  Ctrl-E        edit the selected credential                                  │          "
"          │  Ctrl-D        delete the selected credential (confirm)                      │          "
"          │                                                                              │          "
"          │Settings panel                                                                │          "
"          │  Enter         edit the storage-mode row                                     │          "
"          │                                                                              │          "
"          │↑↓ scroll · F1/Esc close                                                      │          "
"          └──────────────────────────────────────────────────────────────────────────────┘          "
